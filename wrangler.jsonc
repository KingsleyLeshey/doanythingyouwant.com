{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doanythingyouwant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "staging": {
      "name": "doanythingyouwant-staging"
    },
    "production": {
      "name": "doanythingyouwant-production"
    }
  }
}
